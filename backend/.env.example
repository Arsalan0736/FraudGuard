# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=fraudguard

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# LLM (Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# Mongo (optional, for raw event logs)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fraudguard

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true
